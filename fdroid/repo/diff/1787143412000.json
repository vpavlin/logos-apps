ame": "android.permission.USE_FINGERPRINT"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "com.google.android.c2dm.permission.RECEIVE"}, {"name": "xyz.vpavlin.scala.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}, {"name": "com.google.android.finsky.permission.BIND_GET_INSTALL_REFERRER_SERVICE"}, {"name": "com.sec.android.provider.badge.permission.READ"}, {"name": "com.sec.android.provider.badge.permission.WRITE"}, {"name": "com.htc.launcher.permission.READ_SETTINGS"}, {"name": "com.htc.launcher.permission.UPDATE_SHORTCUT"}, {"name": "com.sonyericsson.home.permission.BROADCAST_BADGE"}, {"name": "com.sonymobile.home.permission.PROVIDER_INSERT_BADGE"}, {"name": "com.anddoes.launcher.permission.UPDATE_COUNT"}, {"name": "com.majeur.launcher.permission.UPDATE_BADGE"}, {"name": "com.huawei.android.launcher.permission.CHANGE_BADGE"}, {"name": "com.huawei.android.launcher.permission.READ_SETTINGS"}, {"name": "com.huawei.android.launcher.permission.WRITE_SETTINGS"}, {"name": "android.permission.READ_APP_BADGE"}, {"name": "com.oppo.launcher.permission.READ_SETTINGS"}, {"name": "com.oppo.launcher.permission.WRITE_SETTINGS"}, {"name": "me.everything.badger.permission.BADGE_COUNT_READ"}, {"name": "me.everything.badger.permission.BADGE_COUNT_WRITE"}]}}}}, "xyz.vpavlin.shrooms": {"metadata": {"added": 1787173711000, "categories": ["Internet", "Security"], "issueTracker": "https://github.com/vpavlin/shrooms/issues", "lastUpdated": 1787224601000, "license": "Apache-2.0 OR MIT", "summary": {"en-US": "The mycelial mesh VPN — your devices, no coordinator"}, "description": {"en-US": "An encrypted overlay network between your own machines, with no coordination\nserver to trust or run. Nodes find each other through the network's own\ngossip and move data directly between one another.\n\nWireGuard carries the traffic. Peers find each other over Logos Messaging,\nwhich is used only for rendezvous — once a tunnel exists it keeps working\nwhether or not the messaging network is reachable.\n\nAddresses are derived from device keys, so there is nothing to allocate and\nno address collisions. Peers that cannot reach each other directly fall back\nto a relay, discovered from its own announcement rather than configured.\n\nTo join, scan the code that \"shrooms invite\" prints on a machine already on\nthe mesh. The invite is good for one device and fifteen minutes, and brings\nback a membership credential signed for this phone's own keys. A network key\nstill works where there is no invite to scan.\n\nPrototype.\n"}}, "versions": {"bf47ce0cd65688f1f9b84755ceceb4bfb2dc0bcb65374ae29eb2a15294bfc054": null, "3f53de5973e604393cabc645e69899abc2425fbac7b9df6811fee69d0c52f372": {"added": 1787224601000, "file": {"name": "/shrooms-35.apk", "sha256": "3f53de5973e604393cabc645e69899abc2425fbac7b9df6811fee69d0c52f372", "size": 53728774}, "manifest": {"nativecode": ["arm64-v8a"], "versionName": "deps-v1-305-g34d0d50", "versionCode": 35, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 35}, "signer": {"sha256": ["977c5e5065adad8e24055e70cedd44b4d7b940ff2f32919e7cf348450abb25da"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.CAMERA"}, {"name": "android.permission.NFC"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_SPECIAL_USE"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.RECEIVE_BOOT_COMPLETED"}, {"name": "xyz.vpavlin.shrooms.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}, "8f3551acae2e9d4ccccd1b00781f0a193ffa7c89895a6d9084fe1178f2308276": {"added": 1787173711000, "file": {"name": "/shrooms-34.apk", "sha256": "8f3551acae2e9d4ccccd1b00781f0a193ffa7c89895a6d9084fe1178f2308276", "size": 53712390}, "manifest": {"nativecode": ["arm64-v8a"], "versionName": "deps-v1-279-g2be9af5", "versionCode": 34, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 35}, "signer": {"sha256": ["977c5e5065ada