{"repo": {"timestamp": 1787225430000, "categories": {"Security": {"name": {"en-US": "Security"}}}}, "packages": {"co.logos.delivery": null, "xyz.vpavlin.kith": {"metadata": {"added": 1787225297000, "categories": ["Internet"], "lastUpdated": 1787225297000, "sourceCode": "https://github.com/vpavlin/kith", "authorName": "vpavlin", "name": {"en-US": "Kith"}, "summary": {"en-US": "Your people — a local-first, p2p address book on Loam"}, "description": {"en-US": "Kith is the contacts app of the Loam ecosystem: a local-first, peer-to-peer address book. A contact can carry a Loam identity, turning it into a grantable principal for other apps (Scala editors, Qaku admins). Books sync across your devices; import/export vCards."}, "icon": {"en-US": {"name": "/xyz.vpavlin.kith/en-US/icon_cDrPtCqBvlwzV2eSUqqfWRbiGGoW5wl6SFZZNWZ3eSM=.png", "sha256": "703acfb42a81be5c3357679252aa9f5916e2186a16e7097a4856593566777923", "size": 12553}}, "preferredSigner": "b375d795a12fb87b6cf8042512119ad8771d163b66e9ef0526dbe01aa077d7a8"}, "versions": {"8ce6b1915723afc77b2796b426f4b5240433eca6d488bf4d66614fa5d0bf37e8": {"added": 1787225297000, "file": {"name": "/kith-0.1.0.apk", "sha256": "8ce6b1915723afc77b2796b426f4b5240433eca6d488bf4d66614fa5d0bf37e8", "size": 63129208}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "0.1.0", "versionCode": 1, "usesSdk": {"minSdkVersion": 24, "targetSdkVersion": 36}, "signer": {"sha256": ["b375d795a12fb87b6cf8042512119ad8771d163b66e9ef0526dbe01aa077d7a8"]}, "usesPermission": [{"name": "android.permission.CAMERA"}, {"name": "android.permission.INTERNET"}, {"name": "android.permission.READ_EXTERNAL_STORAGE", "maxSdkVersion": 32}, {"name": "android.permission.RECORD_AUDIO"}, {"name": "android.permission.SYSTEM_ALERT_WINDOW"}, {"name": "android.permission.VIBRATE"}, {"name": "android.permission.WRITE_EXTERNAL_STORAGE", "maxSdkVersion": 32}, {"name": "co.logos.delivery.permission.BIND"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.USE_BIOMETRIC"}, {"name": "android.permission.USE_FINGERPRINT"}, {"name": "xyz.vpavlin.kith.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "xyz.vpavlin.loam": {"metadata": {"added": 1787150855000, "categories": ["System"], "lastUpdated": 1787150855000, "sourceCode": "https://github.com/vpavlin/loam", "authorName": "vpavlin", "name": {"en-US": "Loam"}, "summary": {"en-US": "The shared node your local-first apps grow in — one Waku node per phone"}, "description": {"en-US": "Loam is the soil your Logos apps grow in: one shared liblogosdelivery (Waku) node per\nphone, shared by every app over IPC — so ten apps don't each run ten radios. Per-app\nconsent, end-to-end encrypted (the service only ever moves sealed bytes), and an opt-in\noffline cache that holds a closed app's messages so it reopens without re-syncing. It also\nhosts a Bluetooth-LE mesh, so nearby phones can sync with no internet at all."}, "icon": {"en-US": {"name": "/xyz.vpavlin.loam/en-US/icon_SdidZ-XV5g3OSqZ3Z-47JHxuMxapRVVb2gAghQkTJjc=.png", "sha256": "49d89d67e5d5e60dce4aa67767ee3b247c6e3316a945555bda00208509132637", "size": 49909}}, "preferredSigner": "eb57a553a5e24b5906debfdcf143e243996b9d4149649e9a1aac7674b02b5e2f"}, "versions": {"e81a487e086b4d67bd18f51f6590a5e486791089d7d5317ea921ad7710465827": {"added": 1787150855000, "file": {"name": "/loam-0.0.34.apk", "sha256": "e81a487e086b4d67bd18f51f6590a5e486791089d7d5317ea921ad7710465827", "size": 51369038}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "0.0.34", "versionCode": 34, "usesSdk": {"minSdkVersion": 23, "targetSdkVersion": 34}, "signer": {"sha256": ["eb57a553a5e24b5906debfdcf143e243996b9d4149649e9a1aac7674b02b5e2f"]}, "usesPermission": [{"name": "android.permission.ACCESS_FINE_LOCATION", "maxSdkVersion": 30}, {"name": "android.permission.BLUETOOTH", "maxSdkVersion": 30}, {"name": "android.permission.BLUETOOTH_ADMIN", "maxSdkVersion": 30}, {"name": "android.per