{"repo": {"timestamp": 1787150855000}, "packages": {"co.logos.delivery": null, "xyz.vpavlin.loam": {"metadata": {"added": 1787150855000, "categories": ["System"], "lastUpdated": 1787150855000, "sourceCode": "https://github.com/vpavlin/loam", "authorName": "vpavlin", "name": {"en-US": "Loam"}, "summary": {"en-US": "The shared node your local-first apps grow in — one Waku node per phone"}, "description": {"en-US": "Loam is the soil your Logos apps grow in: one shared liblogosdelivery (Waku) node per\nphone, shared by every app over IPC — so ten apps don't each run ten radios. Per-app\nconsent, end-to-end encrypted (the service only ever moves sealed bytes), and an opt-in\noffline cache that holds a closed app's messages so it reopens without re-syncing. It also\nhosts a Bluetooth-LE mesh, so nearby phones can sync with no internet at all."}, "icon": {"en-US": {"name": "/xyz.vpavlin.loam/en-US/icon_SdidZ-XV5g3OSqZ3Z-47JHxuMxapRVVb2gAghQkTJjc=.png", "sha256": "49d89d67e5d5e60dce4aa67767ee3b247c6e3316a945555bda00208509132637", "size": 49909}}, "preferredSigner": "eb57a553a5e24b5906debfdcf143e243996b9d4149649e9a1aac7674b02b5e2f"}, "versions": {"e81a487e086b4d67bd18f51f6590a5e486791089d7d5317ea921ad7710465827": {"added": 1787150855000, "file": {"name": "/loam-0.0.34.apk", "sha256": "e81a487e086b4d67bd18f51f6590a5e486791089d7d5317ea921ad7710465827", "size": 51369038}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "0.0.34", "versionCode": 34, "usesSdk": {"minSdkVersion": 23, "targetSdkVersion": 34}, "signer": {"sha256": ["eb57a553a5e24b5906debfdcf143e243996b9d4149649e9a1aac7674b02b5e2f"]}, "usesPermission": [{"name": "android.permission.ACCESS_FINE_LOCATION", "maxSdkVersion": 30}, {"name": "android.permission.BLUETOOTH", "maxSdkVersion": 30}, {"name": "android.permission.BLUETOOTH_ADMIN", "maxSdkVersion": 30}, {"name": "android.permission.BLUETOOTH_ADVERTISE"}, {"name": "android.permission.BLUETOOTH_CONNECT"}, {"name": "android.perm