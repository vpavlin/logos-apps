oid.permission.READ_APP_BADGE"}, {"name": "com.oppo.launcher.permission.READ_SETTINGS"}, {"name": "com.oppo.launcher.permission.WRITE_SETTINGS"}, {"name": "me.everything.badger.permission.BADGE_COUNT_READ"}, {"name": "me.everything.badger.permission.BADGE_COUNT_WRITE"}]}}}}, "xyz.vpavlin.shrooms": {"metadata": {"added": 1786706039000, "categories": ["Internet"], "lastUpdated": 1786706039000, "sourceCode": "https://github.com/vpavlin/shrooms", "authorName": "vpavlin", "name": {"en-US": "Shrooms"}, "summary": {"en-US": "An overlay mesh between your own devices"}, "description": {"en-US": "Your laptop, phone, NAS and a VPS get addresses on a private IPv6 network and talk to each other directly over WireGuard — from a cafe, from mobile data, from another country. Peers find each other over a public gossip network rather than a coordination server, so there is no account, no server to run, and no company that can see your traffic, switch it off, or go out of business. The phone is a full participant running the same core as the daemon, joins several meshes at once, and roams between wifi and mobile data. A prototype in daily use by its author."}, "icon": {"en-US": {"name": "/xyz.vpavlin.shrooms/en-US/icon_CPn4UeaEZIiRBtK3fEpzdUsUgZyQn0PxGNO1G2nfWCY=.png", "sha256": "08f9f851e68464889106d2b77c4a73754b14819c909f43f118d3b51b69df5826", "size": 13676}}, "preferredSigner": "977c5e5065adad8e24055e70cedd44b4d7b940ff2f32919e7cf348450abb25da"}, "versions": {"bf47ce0cd65688f1f9b84755ceceb4bfb2dc0bcb65374ae29eb2a15294bfc054": {"added": 1786706039000, "file": {"name": "/shrooms-1.2-invites.apk", "sha256": "bf47ce0cd65688f1f9b84755ceceb4bfb2dc0bcb65374ae29eb2a15294bfc054", "size": 52057606}, "manifest": {"nativecode": ["arm64-v8a"], "versionName": "1.2-invites", "versionCode": 30, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 35}, "signer": {"sha256": ["977c5e5065adad8e24055e70cedd44b4d7b940ff2f32919e7cf348450abb25da"]}, "usesPermission": [{"name": "android.permission.INTERNET"