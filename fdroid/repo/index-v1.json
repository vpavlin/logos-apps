{"repo": {"timestamp": 1786377548000, "version": 20002, "name": "Logos Apps (vpavlin)", "icon": "icon.png", "address": "https://apps.vpavlin.xyz/fdroid/repo", "description": "Public repo for vpavlin Logos apps (QAKU + more)."}, "requests": {"install": [], "uninstall": []}, "apps": [{"authorName": "vpavlin", "categories": ["Money"], "suggestedVersionCode": "48", "description": "KYM (Know Your Money) is a local-first, peer-to-peer zero-based budget you\nown. Shared household budgets sync directly between devices over Waku \u2014 no\nbank login, no server.", "license": "Unknown", "name": "KYM \u2014 Know Your Money", "sourceCode": "https://github.com/vpavlin/kym", "summary": "Local-first p2p zero-based budgeting on Logos", "added": 1786369788000, "packageName": "xyz.vpavlin.kym", "lastUpdated": 1786369788000, "localized": {"en-US": {"icon": "icon_gD0gGnpwUW_WbiCBL4oNfY712LlMoUyPXvr1_XCj2Jg=.png"}}}, {"authorName": "vpavlin", "categories": ["Internet"], "suggestedVersionCode": "10", "description": "Runs one Logos Delivery (Waku) node for the whole phone in a foreground service. Other Logos apps like QAKU and KYM bind to it over IPC and sync through this one node instead of each embedding their own \u2014 saving battery and data. You approve each app once.", "license": "Unknown", "name": "Logos Delivery", "sourceCode": "https://github.com/vpavlin/logos-shared-delivery", "summary": "Shared Waku delivery node \u2014 one per phone; apps bind over IPC", "added": 1786375883000, "packageName": "co.logos.delivery", "lastUpdated": 1786375883000, "localized": {"en-US": {"icon": "icon_zi08-LBoPHFuuronqt8gP2n_FUzXXarhazIz40vVSVI=.png"}}}, {"authorName": "vpavlin", "categories": ["Sports & Health"], "suggestedVersionCode": "15", "description": "Perun records your runs (GPS route, pace, distance) on your phone and delivers them privately to the Perun Analytics module in your Logos Basecamp over Waku \u2014 no account, no server. Now runs on the shared Logos Delivery node when enabled.", "license": "Unknown", "name": "Perun", "sourceCode": "https://github.com/vpavlin/perun", "summary": "Local-first run tracker that syncs to your Basecamp over Logos", "added": 1786377202000, "packageName": "co.logos.perun", "lastUpdated": 1786377202000, "localized": {"en-US": {"icon": "icon__TmX5RMI12ih0LBn3TjEQHhJpjyLERHAnixwpWtE6Vk=.png"}}}, {"authorName": "vpavlin", "categories": ["Internet"], "suggestedVersionCode": "60", "description": "Local-first p2p Q&A on Logos", "license": "Unknown", "name": "QAKU", "sourceCode": "https://github.com/vpavlin/qaku-logos", "summary": "Local-first p2p Q&A on Logos", "added": 1786369790000, "packageName": "xyz.vpavlin.qaku", "lastUpdated": 1786369790000, "localized": {"en-US": {"icon": "icon_aVHBBfOBIfPRhNYw4N9eGNjPeBeFtU2Ay9QtSWhXz24=.png"}}}], "packages": {"co.logos.delivery": [{"added": 1786375883000, "apkName": "delivery-0.0.10.apk", "hash": "b49c43a43effc6db933c1529146b7a4df653c2619757884634286dfd6f11eabf", "hashType": "sha256", "minSdkVersion": 23, "nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "packageName": "co.logos.delivery", "sig": "b004a2470b0626b25683441508275712", "signer": "eb57a553a5e24b5906debfdcf143e243996b9d4149649e9a1aac7674b02b5e2f", "size": 50548194, "targetSdkVersion": 34, "uses-permission": [["android.permission.CAMERA", null], ["android.permission.FOREGROUND_SERVICE", null], ["android.permission.FOREGROUND_SERVICE_DATA_SYNC", null], ["android.permission.INTERNET", null], ["android.permission.POST_NOTIFICATIONS", null], ["android.permission.READ_EXTERNAL_STORAGE", null], ["android.permission.RECORD_AUDIO", null], ["android.permission.SYSTEM_ALERT_WINDOW", null], ["android.permission.VIBRATE", null], ["android.permission.WRITE_EXTERNAL_STORAGE", null], ["android.permission.RECEIVE_BOOT_COMPLETED", null], ["android.permission.USE_BIOMETRIC", null], ["android.permission.USE_FINGERPRINT", null], ["android.permission.ACCESS_NETWORK_STATE", null], ["android.permission.WAKE_LOCK", null], ["com.