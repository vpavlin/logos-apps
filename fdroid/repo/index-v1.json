{"repo": {"timestamp": 1786700186000, "version": 20002, "name": "Logos Apps (vpavlin)", "icon": "icon.png", "address": "https://apps.vpavlin.xyz/fdroid/repo", "description": "Public repo for vpavlin Logos apps (QAKU + more)."}, "requests": {"install": [], "uninstall": []}, "apps": [{"authorName": "vpavlin", "categories": ["Money"], "suggestedVersionCode": "48", "description": "KYM (Know Your Money) is a local-first, peer-to-peer zero-based budget you\nown. Shared household budgets sync directly between devices over Waku \u2014 no\nbank login, no server.", "license": "Unknown", "name": "KYM \u2014 Know Your Money", "sourceCode": "https://github.com/vpavlin/kym", "summary": "Local-first p2p zero-based budgeting on Logos", "added": 1786369788000, "packageName": "xyz.vpavlin.kym", "lastUpdated": 1786369788000, "localized": {"en-US": {"icon": "icon_gD0gGnpwUW_WbiCBL4oNfY712LlMoUyPXvr1_XCj2Jg=.png"}}}, {"authorName": "vpavlin", "categories": ["System"], "suggestedVersionCode": "14", "description": "One liblogosdelivery (Waku) node per phone, shared by every Logos app over AIDL. Per-app consent, end-to-end encrypted (the service only moves sealed bytes), and an opt-in offline cache that holds a closed app's messages so it reopens without re-syncing.", "license": "Unknown", "name": "Logos Delivery", "sourceCode": "https://github.com/vpavlin/logos-shared-delivery", "summary": "Shared Waku delivery node \u2014 one per phone; apps bind over IPC", "added": 1786375883000, "packageName": "co.logos.delivery", "lastUpdated": 1786612502000, "localized": {"en-US": {"icon": "icon_zi08-LBoPHFuuronqt8gP2n_FUzXXarhazIz40vVSVI=.png"}}}, {"authorName": "vpavlin", "categories": ["Sports & Health"], "suggestedVersionCode": "17", "description": "Perun records your runs (GPS route, pace, distance) on your phone and delivers them privately to the Perun Analytics module in your Logos Basecamp over Waku \u2014 no account, no server. Records with the screen off, and can run on the shared Logos Delivery node (toggle in Pairing).", "license": "Unknown", "name": "Perun", "sourceCode": "https://github.com/vpavlin/perun", "summary": "Local-first run tracker that syncs to your Basecamp over Logos", "added": 1786377202000, "packageName": "co.logos.perun", "lastUpdated": 1786379650000, "localized": {"en-US": {"icon": "icon__TmX5RMI12ih0LBn3TjEQHhJpjyLERHAnixwpWtE6Vk=.png"}}}, {"authorName": "vpavlin", "categories": ["Internet"], "suggestedVersionCode": "60", "description": "Local-first p2p Q&A on Logos", "license": "Unknown", "name": "QAKU", "sourceCode": "https://github.com/vpavlin/qaku-logos", "summary": "Local-first p2p Q&A on Logos", "added": 1786369790000, "packageName": "xyz.vpavlin.qaku", "lastUpdated": 1786369790000, "localized": {"en-US": {"icon": "icon_aVHBBfOBIfPRhNYw4N9eGNjPeBeFtU2Ay9QtSWhXz24=.png"}}}, {"authorName": "vpavlin", "categories": ["Internet"], "suggestedVersionCode": "29", "description": "Local-first shared calendar, p2p over Logos", "license": "Unknown", "name": "Scala", "sourceCode": "https://github.com/vpavlin/scala", "summary": "Local-first shared calendar, p2p over Logos", "added": 1786698257000, "packageName": "xyz.vpavlin.scala", "lastUpdated": 1786700186000, "localized": {"en-US": {"icon": "icon_cDrPtCqBvlwzV2eSUqqfWRbiGGoW5wl6SFZZNWZ3eSM=.png"}}}], "packages": {"co.logos.delivery": [{"added": 1786612502000, "apkName": "delivery-0.0.14.apk", "hash": "7477efc5d601e88a88ec34d7f1dc521873983259dd5e482d95c20640c5d1fd5c", "hashType": "sha256", "minSdkVersion": 23, "nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "packageName": "co.logos.delivery", "sig": "b004a2470b0626b25683441508275712", "signer": "eb57a553a5e24b5906debfdcf143e243996b9d4149649e9a1aac7674b02b5e2f", "size": 50550227, "targetSdkVersion": 34, "uses-permission": [["android.permission.CAMERA", null], ["android.permission.FOREGROUND_SERVICE", null], ["android.permission.FOREGROUND_SERVICE_DATA_SYNC", null], ["android.permission.INTERNET", null], ["android.permission